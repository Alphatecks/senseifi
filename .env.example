# Backend API URL (wallet, dashboard, subscriptions — same SenseiFi API)
NEXT_PUBLIC_WALLET_API_URL=https://senseifi-backend.onrender.com/api
# Optional override for subscription endpoints only (defaults to NEXT_PUBLIC_WALLET_API_URL)
# NEXT_PUBLIC_SUBSCRIPTIONS_API_URL=https://senseifi-backend.onrender.com/api

# Legacy — do not point at the Next.js dev server (/api routes are not implemented here)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Reown / WalletConnect project ID (https://dashboard.reown.com) — required for multi-wallet connect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Waitlist API base URL (no trailing slash). Used for POST /waitlist.
NEXT_PUBLIC_WAITLIST_API_BASE_URL=https://waitlist-82co.onrender.com

# On-chain billing environment: "test" (Base Sepolia) or "production" (Base mainnet)
NEXT_PUBLIC_ONCHAIN_BILLING_ENV=test

# Base Sepolia = 84532, Base mainnet = 8453
NEXT_PUBLIC_ONCHAIN_CHAIN_ID=84532

# Circle USDC on Base / Base Sepolia (defaults to canonical address if omitted)
NEXT_PUBLIC_ONCHAIN_USDC_CONTRACT=0x036cbd53842c686983057b837BbAF642Ea437901

# SenseiFi payment contract on the selected network (required for testnet if backend returns mainnet addresses)
NEXT_PUBLIC_ONCHAIN_PAYMENT_CONTRACT=
